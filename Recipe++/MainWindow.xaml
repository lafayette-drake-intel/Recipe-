<Window x:Class="Recipe__.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Recipe__"
        mc:Ignorable="d"
        FocusManager.FocusedElement="{Binding ElementName=recipeName}"
        Title="Recipe++" Height="650" MinWidth="1150" MaxWidth="1150" KeyDown="HandleKeyDownEvent">
    <Grid>
        <Label x:Name="label" Width="60" Height="30" Margin="60,0,0,0" Content="Recipe" FontSize="14" FontWeight="Bold"
               HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button x:Name="backButton"    Content="f" FontFamily="Wingdings 3" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="05,30,0,0" VerticalAlignment="Top" Width="25" Height="25" BorderThickness="0"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" ToolTip="Back" ToolTipService.ShowOnDisabled="True" Click="Back_Click"/>
        <Button x:Name="forwardButton" Content="g" FontFamily="Wingdings 3" FontSize="20" FontWeight="Bold" HorizontalAlignment="Left" Margin="30,30,0,0" VerticalAlignment="Top" Width="25" Height="25" BorderThickness="0"  
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" ToolTip="Forward" ToolTipService.ShowOnDisabled="True" Click="Forward_Click"/>
        <TextBox x:Name="recipeName"        Margin="60,30,0,0"       Height="25" Width="1000" Text="" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center" KeyDown="OnEnterDown"/>
        <ScrollViewer MinHeight="420" MinWidth="1000" MaxWidth="1000" Margin="00,65,0,0" Padding="10" HorizontalAlignment="Left">
            <Border BorderThickness="1" BorderBrush="Blue">
                <TextBlock x:Name="recipeText"  MinHeight="400" MinWidth="960" MaxWidth="960" Margin="0,0,0,0" Padding="0" 
                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 Background="Lavender" Foreground="Black" Drop="OnFileDrop" AllowDrop="True" MouseRightButtonDown="TextBlock_RightMouseDown">
                </TextBlock>
            </Border>
        </ScrollViewer>

        <Button x:Name="browseButton"       Margin="1070,030,00,00"  Height="25" Width="50" Content = "..." ToolTip="Browse" VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Click = "Browse_Click"/>
        <StackPanel Margin="1005,100,00,00" Height="85" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Green">
            <!--<Button x:Name="recipeButton"       Margin="05,05,00,00"  Height="25" Width="110" Content = "Validate Paths"    HorizontalAlignment="Left" VerticalAlignment="Top" Click = "Recipe_Click"/>-->
            <!--<Button x:Name="checksumButton"     Margin="05,05,00,00"  Height="25" Width="110" Content = "Validate Checksum" HorizontalAlignment="Left" VerticalAlignment="Top" Click = "Checksum_Click"/>-->
            <!--<Button x:Name="guidButton"         Margin="05,05,00,00"  Height="25" Width="110" Content = "Validate GUIDs"    HorizontalAlignment="Left" VerticalAlignment="Top" Click = "GUID_Click"/>-->
            <Button x:Name="allcheckButton"     Margin="05,05,00,00"  Height="35" Width="110" Content = "Check Recipe" ToolTip="Check everything except LTL" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "All_Click"/>
            <Button x:Name="ltlButton"          Margin="05,05,00,00"  Height="35" Width="110" Content = "Check LTL"    ToolTip="Check that LTL has uploaded" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "LTL_Click"/>
        </StackPanel>
        <StackPanel Margin="1005,200,00,00" Height="85" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Red">
            <!--<Button x:Name="updateGUIDButton"   Margin="05,05,00,00"  Height="25" Width="110" Content = "Update GUIDs"      HorizontalAlignment="Left" VerticalAlignment="Top" Click = "Update_GUIDs_Click"/>-->
            <!--<Button x:Name="updateChkButton"    Margin="05,05,00,00"  Height="25" Width="110" Content = "Update Checksum"   HorizontalAlignment="Left" VerticalAlignment="Top" Click = "Update_Checksum_Click"/>-->
            <Button x:Name="updateRecipeButton" Margin="05,05,00,00"  Height="35" Width="110" Content = "Save As"      ToolTip="Save recipe as a new one" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "SaveAs_Click"/>
            <Button x:Name="openInNotepad"      Margin="05,05,00,00"  Height="35" Width="110" Content = "ToNotepad++"  ToolTip="Send recipe to Notepad++" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "OpenInNotepad_Click"/>
            <!--Button x:Name="beyondCompare"      Margin="05,05,00,00"  Height="25" Width="110" Content = "Beyond Compare"    HorizontalAlignment="Left" VerticalAlignment="Top" Click = "Beyond_Compare"/-->
        </StackPanel>
        <StackPanel Margin="1005,300,00,00" Height="110" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top" Background="DarkViolet">
            <Button x:Name="lot2recipeButton"   Margin="10,05,00,00"  Height="30" Width="100" Content = "Lot->Recipe" ToolTip="Pull recipe from LotID" VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "Lot2Recipe_Click"/>
            <Button x:Name="amctpullButton"     Margin="10,05,00,00"  Height="30" Width="100" Content = "AMCT++"      ToolTip="Pull AMCT and filter"   VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "Amct_Click"/>
            <Button x:Name="transferButton"     Margin="10,05,00,00"  Height="30" Width="100" Content = "ToTransfer"  ToolTip="Trasfer/copy recipes"   VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "Transfer_Click"/>
        </StackPanel>
        <!--<Button x:Name="lot2recipeButton"   Margin="1015,300,00,00"  Height="30" Width="100" Content = "Lot->Recipe" ToolTip="Pull recipe from LotID" VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "Lot2Recipe_Click"/>-->
        <!--<Button x:Name="amctpullButton"     Margin="1015,335,00,00"  Height="30" Width="100" Content = "AMCT++"     ToolTip="Pull AMCT and filter"   VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "Amct_Click"/>-->
        <!--<Button x:Name="transferButton"     Margin="1015,370,00,00"  Height="30" Width="100" Content = "ToTransfer"   ToolTip="Trasfer/copy recipes"   VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource btnBlue}" Click = "Transfer_Click"/>-->
        <!--<Button x:Name="xiuprefixButton"    Margin="1020,485,00,00"  Height="20" Width="100" Content = "XIU check"  ToolTip="Pull matching XIUs"     VerticalContentAlignment="Top" HorizontalAlignment="Left" VerticalAlignment="Top" Click = "Xiu_Click"/>-->
        
        <StackPanel Margin="1005,425,00,00" Height="60" Width="120" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border BorderThickness="1" BorderBrush="Black">
                <TextBlock Margin="10,5" Foreground="Blue" FontStyle="Italic" FontWeight="Bold" FontSize="12" TextWrapping="Wrap"> Golam Rabbani STTD DieSort IPE</TextBlock>
            </Border>
        </StackPanel>
    </Grid>
</Window>
