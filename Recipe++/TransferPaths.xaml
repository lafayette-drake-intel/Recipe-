<Window x:Class="Recipe__.TransferPaths"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Recipe__"
        mc:Ignorable="d"
        Title="Pick recipes to transfer" Height="500" Width="1000">
    <Grid x:Name="parentGrid">
        <Label x:Name="labelSrc" Content="Source Drive and File" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="010,05,0,0" Height="25" Width="200"/>
        <Label x:Name="labelDst" Content="Destination Drive"     FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="250,05,0,0" Height="25" Width="200"/>
        <Button x:Name="browseSrc" Content="..." HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Top" Margin="215,30,0,0" Height="25" Width="15" Click="SrcBrowse_Click"/>
        <Button x:Name="browseDst" Content="..." HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Top" Margin="455,30,0,0" Height="25" Width="15" Click="DstBrowse_Click"/>
        <TextBox x:Name="boxSrc" Text="\\alpfile3.al.intel.com\sdx\"  HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="015,30,0,0" Height="25" Width="200"/>
        <TextBox x:Name="boxDst" Text="\\vmspfsfseg08\SDxGDTransfer\" HorizontalAlignment="Left" VerticalAlignment="Top" VerticalContentAlignment="Center" Margin="255,30,0,0" Height="25" Width="200"/>
        <Button x:Name="buttonTransferSelected" Content="Transfer Selected Files" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,70,0,0" Width="130" Height="25" Click="TransferButton_Click"/>
        <Grid x:Name="checkboxGrid">

        </Grid>
    </Grid>
    
</Window>
