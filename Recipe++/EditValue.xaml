<Window x:Class="Recipe__.EditValue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Recipe__"
        mc:Ignorable="d"
        Title="Edit path" Height="175" Width="800" WindowStartupLocation="CenterOwner">
    <Grid>
        <TextBlock x:Name="textBlock"    Text="New path"  HorizontalAlignment="Left" Margin="15,15,0,0"   VerticalAlignment="Top"/>
        <TextBox   x:Name="textBox"      Text=""          HorizontalAlignment="Left" Margin="15,40,0,0"   VerticalAlignment="Top" Width="725" Height="30" VerticalContentAlignment="Center"/>
        <Button    x:Name="goButton"     Content ="..."   HorizontalAlignment="Left" Margin="745,40,0,0"  VerticalAlignment="Top" Width="20" Height="30" Click="Browse_Click"/>
        <Button    x:Name="updateButton" Content="Update Name" HorizontalAlignment="Left" Margin="15,75,0,0" VerticalAlignment="Top" Width="80" Height="20" Click="updateButton_Click"/>
        <Button    x:Name="cancelButton" Content="Cancel" HorizontalAlignment="Left" Margin="500,100,0,0" VerticalAlignment="Top" Width="75" Height="25" Click="cancelButton_Click"/>
        <Button    x:Name="okButton"     Content ="OK"    HorizontalAlignment="Left" Margin="600,100,0,0" VerticalAlignment="Top" Width="75" Height="25" Click="okButton_Click"/>
    </Grid>
</Window>
